# PostgreSQL connection string. Add sslmode=require for hosted databases that
# require TLS. If omitted, the legacy DB_* variables below are used.
DATABASE_URL=postgresql+psycopg2://username:password@host:5432/database?sslmode=require

# Local/legacy PostgreSQL settings (used only when DATABASE_URL is unset).
# DB_USER=username
# DB_PASSWORD=replace-with-database-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hr_voice_agent

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

VOICE_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Required only when using OpenAI Realtime voice mode.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Set to the exact deployed frontend origin. Comma-separated origins are supported.
FRONTEND_URL=change_me

# Required only for creating/updating the HR account with create_hr_user.py.
HR_EMAIL=hr@example.com
HR_PASSWORD=password

# Required to send outcome emails from the HR dashboard.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hr@example.com
SMTP_USE_TLS=true
